{
  "name": "corp-portal-ui",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration local",
    "build": "ng build",
    "watch": "ng build --watch --configuration local",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"scripts/*.mjs\" \"infra/**/*.js\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"scripts/*.mjs\" \"infra/**/*.js\" README.md",
    "start:dev": "ng serve --configuration dev",
    "start:prod": "ng serve --configuration prod",
    "build:dev": "ng build --configuration dev",
    "build:prod": "ng build --configuration prod",
    "build:ci": "node scripts/build-ci.mjs",
    "test:deployment": "node --test scripts/*.test.mjs",
    "deploy:frontend": "node scripts/deploy-frontend.mjs",
    "start:local": "ng serve --configuration local",
    "build:local": "ng build --configuration local"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@primeuix/themes": "2.0.3",
    "chart.js": "4.6.1",
    "ng2-charts": "10.0.0",
    "primeicons": "7.0.0",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
